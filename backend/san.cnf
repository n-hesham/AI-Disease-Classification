[req]
default_bits       = 2048
prompt             = no
default_md         = sha256
req_extensions     = req_ext
distinguished_name = dn

[dn]
C = EG
ST = Cairo
L = Cairo
O = MyCompany
OU = MyDepartment
CN = myapp.local

[req_ext]
subjectAltName = @alt_names

[alt_names]
DNS.1 = myapp.local
